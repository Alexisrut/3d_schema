# Что НЕ должно попасть в образ бэкенда.
#
# Без этого файла в сборку уедут виртуальное окружение, боевая база и
# загруженные модели — сотни мегабайт, и, что хуже, .env с паролями SMTP
# оказался бы внутри образа, который потом уйдёт в реестр.

.venv/
venv/
__pycache__/
*.py[cod]

# Секреты: настройки монтируются через env_file, а не вшиваются в образ.
.env

# Данные живут в примонтированном каталоге, а не в образе.
data.db
data.db-wal
data.db-shm
storage/

# Тесты и вспомогательные скрипты на сервере не нужны.
tests/
tools/
