# Пример настроек. Скопируйте в backend/.env и заполните.
# Файл .env в репозиторий не попадает (см. .gitignore).

# --- Безопасность -----------------------------------------------------------
# ОБЯЗАТЕЛЬНО замените перед запуском вне localhost.
APP_SECRET_KEY=замените-на-длинную-случайную-строку

# --- Почта ------------------------------------------------------------------
# Нужна для подтверждения адреса и писем о задачах и проблемах.
# Без этих настроек приложение работает как обычно, а письма пишутся в журнал
# сервера — в том числе код подтверждения.
#
# ВАЖНО для Яндекса — два отдельных условия:
#  1) здесь нужен ПАРОЛЬ ПРИЛОЖЕНИЯ из Яндекс ID (id.yandex.ru → Безопасность
#     → Пароли приложений → «Почта»), а НЕ пароль от аккаунта. Обычный пароль
#     отклоняется с ошибкой «535 5.7.8 Invalid user or password»;
#  2) в самом ящике должен быть РАЗРЕШЁН доступ почтовым программам:
#     Почта → Настройки → «Почтовые программы» → включить доступ по IMAP.
#     Пока он выключен, даже верный пароль приложения даёт
#     «535 5.7.8 This user does not have access rights to this service».
APP_SMTP_HOST=smtp.yandex.ru
APP_SMTP_PORT=465
APP_SMTP_USE_SSL=true
APP_SMTP_USERNAME=vis-group-auto@yandex.ru
APP_SMTP_PASSWORD=пароль-приложения-из-яндекс-id
# Адрес в поле «От кого»; по умолчанию совпадает с логином.
APP_SMTP_SENDER=vis-group-auto@yandex.ru

# Внешний адрес интерфейса — попадает в ссылки внутри писем.
APP_PUBLIC_BASE_URL=http://localhost:5173

# --- Прочее -----------------------------------------------------------------
