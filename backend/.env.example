# Пример настроек. Скопируйте в backend/.env и заполните.
# Файл .env в репозиторий не попадает (см. .gitignore).

# --- Безопасность -----------------------------------------------------------
# ОБЯЗАТЕЛЬНО замените перед запуском вне localhost. Этим ключом подписываются
# токены входа: со значением по умолчанию любой, кто видел исходники, сможет
# выписать себе токен администратора. Сгенерировать:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=замените-на-длинную-случайную-строку

# Учётная запись администратора, создаётся при ПЕРВОМ запуске на пустой базе.
# Задайте свой пароль здесь — иначе будет создан admin/admin123.
# На уже работающей базе эти значения ни на что не влияют: пароль меняется
# в «Личном кабинете».
APP_SEED_ADMIN_USERNAME=admin
APP_SEED_ADMIN_PASSWORD=замените-на-свой-пароль

# --- Почта ------------------------------------------------------------------
# Нужна для подтверждения адреса и писем о задачах и проблемах.
# Без этих настроек приложение работает как обычно, а письма пишутся в журнал
# сервера — в том числе код подтверждения. Признак «не настроено» видно по
# строке в логе: «SMTP не настроен — письмо не отправлено».
#
# ВЕЗДЕ нужен ПАРОЛЬ ПРИЛОЖЕНИЯ, а не пароль от аккаунта: обычный пароль
# SMTP отклоняет с ошибкой «535 Invalid user or password».
#
# Рабочий вариант — Mail.ru (проверен на этом проекте):
#   пароль: Почта → Настройки → «Пароли для внешних приложений» → создать.
APP_SMTP_HOST=smtp.mail.ru
APP_SMTP_PORT=465
APP_SMTP_USE_SSL=true
APP_SMTP_USERNAME=vis_group_auto@mail.ru
APP_SMTP_PASSWORD=пароль-для-внешних-приложений
# Адрес в поле «От кого»; по умолчанию совпадает с логином.
APP_SMTP_SENDER=vis_group_auto@mail.ru

# Вариант с Яндексом требует ДВУХ отдельных условий и на новом ящике часто
# упирается в репутацию отправителя — см. README, раздел 6.1:
#  1) пароль приложения из Яндекс ID (id.yandex.ru → Безопасность → Пароли
#     приложений → «Почта»);
#  2) в самом ящике разрешён доступ почтовым программам: Почта → Настройки →
#     «Почтовые программы» → включить доступ по IMAP. Пока он выключен, даже
#     верный пароль приложения даёт «535 This user does not have access
#     rights to this service».
# APP_SMTP_HOST=smtp.yandex.ru
# APP_SMTP_USERNAME=ящик@yandex.ru

# Внешний адрес интерфейса — попадает в ссылки внутри писем. На сервере
# укажите тот адрес, по которому люди реально открывают систему, например
# http://10.0.0.15 или https://monitoring.company.ru. Со значением по
# умолчанию ссылки в письмах будут вести получателю на его собственный
# компьютер.
APP_PUBLIC_BASE_URL=http://localhost:5173

# --- Развёртывание в Docker -------------------------------------------------
# Эти две строки задаёт docker-compose.yml, здесь их указывать НЕ НУЖНО:
#   APP_DATABASE_URL=sqlite:////data/data.db
#   APP_STORAGE_DIR=/data/storage
# Они уводят базу и загруженные модели в примонтированный каталог ./data,
# который переживает пересборку образов.

# --- Прочее -----------------------------------------------------------------
# APP_DATABASE_URL=sqlite:///./data.db
# APP_MAX_MODEL_MB=512
# APP_MAX_ATTACHMENT_MB=25
